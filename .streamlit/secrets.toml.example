# Copy to .streamlit/secrets.toml and paste the real Neon connection string.
# That file is gitignored; this example is the one that gets committed.
#
# Neon gives you the string under "Connection Details" on the project dashboard.
# Use the POOLED connection ("-pooler" in the host) for the Streamlit app.
# sslmode=require is not optional — Neon refuses plaintext connections.

[connections]
database_url = "postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/rentalman?sslmode=require"
